<% provide(:title,'Home')%>

  <%= react_component("Intro") %>

  <section class="features">
    <%= react_component("Feature", { 
      title: "Create Trips", 
      about: "Set up trips with names, dates, and participants.",
      link: new_trip_path
      }) %>
    <%= react_component("Feature", { 
      title: "View Trips", 
      about: "View your trips and log costs like gas, lodging, food, and entertainment.",
      link: trip_index_path
    }) %>
    <%= react_component("Feature", { 
      title: "Add Your Friends", 
      about: "Add your friends' ID's to your trip, and manage expenses.",
      link: users_path
      }) %>
    <%= react_component("Feature", { 
      title: "Trip Planner", 
      about: "See what trips you can take with your budget.", 
      className: "single",
      link: "/trip_budget"
      }) %>
  </section>
