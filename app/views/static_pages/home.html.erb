<% provide(:title,'Home')%>


  <style>
  h1 {
      margin: 0;
      font-size: 2.5rem;
    }

    p {
      margin-top: 0.5rem;
      font-size: 1.2rem;
    }

    section {
      padding: 2rem;
      max-width: 900px;
      margin: auto;
    }

    section h2 {
      color: black;
      margin-bottom: 1rem;
    }
    .hero {
      text-align: center;
      background: #e8f5e9;
      padding: 3rem 2rem;
      border-radius: 8px;
    }

    .hero h2 {
      font-size: 2rem;
    }

    .features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  max-width: 900px;
  margin: auto;
}

.features article {
  background: white;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 1.5rem;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.features .single {
  grid-column: 2;
}
  </style>

  <section class="hero">
    <h2>Welcome to Split the Bill</h2>
    <p>Going on a trip with friends? Keep track of expenses, balances, and settlements all in one place.</p>
  </section>

  <section class="features">
  <article>
    <h3>Create Trips</h3>
    <p>Set up trips with names, dates, and participants.</p>
  </article>
  <article>
    <h3>Add Expenses</h3>
    <p>Log costs like gas, lodging, food, and entertainment.</p>
  </article>
  <article>
    <h3>Track Balances</h3>
    <p>See who spent what and who owes whom.</p>
  </article>
  <article class="single">
    <h3>Settle Debts</h3>
    <p>Get a simple list of transactions to balance everything.</p>
  </article>
</section>
