<% provide(:title, 'Expense Sheet') %>
<%= button_to "Add Expense", new_trip_expense_path(@trip), class: "big-button"%>
<h1>Expenses</h1>
<table class = "mytable">
    <thead>
        <tr>
            <th>Description</th>
            <th>Amount</th>
            <th>Paid By</th>
            <th>Owed By</th>
        </tr>
    </thead>
    <tbody>
        <% @expenses.each do |expense|%>
            <tr>
                <td><%= expense.description%></td>
                <td><%= expense.amount%></td>
                <td><%= @users_by_id[expense.payer.id]&.name%></td>
                <td><%= expense.owed_by_array.map { |uid| @users_by_id[uid]&.name}.join(", ")%></td>
            </tr>
        <% end %>
    </tbody>
</table>
<h1>Balances</h1>
<table class = "mytable">
    <thead>
        <tr>
            <th>Owes</th>
            <th>To</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        <% @balances.each do |user_id, owes_hash|%>
          <% owes_hash.each do |to_id, amount|%>
            <tr>
                <td><%= @users_by_id[user_id]&.name %></td>
                <td><%= @users_by_id[to_id]&.name %></td>
                <td><%= amount.round(2) %></td>
            </tr>
          <% end %>
        <% end %>
    </tbody>
</table>