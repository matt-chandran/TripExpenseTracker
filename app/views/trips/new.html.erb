<% provide(:title, 'Create Trip') %>
<%= form_with(model: @trip, html: { class: "form-style" }) do |form| %>
  <fieldset class="form-fieldset">
    <legend class="form-legend">Create Trip</legend>
    <div>
      <%= form.label :name %>
      <%= form.text_field :name%>
    </div>
    <div>
      <%= form.label :start_date %>
      <%= form.date_field :start_date%>
    </div>
    <div>
      <%= form.label :end_date %>
      <%= form.date_field :end_date %>
    </div>
    <div>
      <%= label_tag :participant_ids_text, "Participant User IDs Seperated by comas"%>
      <%= text_field_tag :participant_ids_text, @trip.participant_ids %>
    </div>
    <%= form.submit "Create trip" %>
  </fieldset>
<% end %>

<script>
//document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector("form");
    const input = document.querySelector("input[name='participant_ids_text']");

    //form.addEventListener("submit", (x) => {
        //x.preventDefault(); //prevents submission

        //Promise returning function
        function validateUsers(idsArray) {
            return new Promise((resolve, reject) => {
                fetch("/users/validate_ids", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({ids: idsArray})
                })
                .then(response => response.json())
                .then(data => {
                    if(data.valid) {
                        resolve();
                    } else {
                        reject(data.invalid_ids); //contains the bad ids
                    }
                })
                .catch(err => reject(err));
            });
        }

        const idsArray = input.value
        .split(",")
        .map(i=>i.trim())
        .filter(i => i.length > 0)
        .map(i => parseInt(i));

        validateUsers(idsArray)
        .then(() => {
            //if the ids are good submit form
            form.submit();
        })
        .catch((invalid) => {
            alert(`Invalid Users, IDs: ${invalid}`);
        });
    //});
//});
</script>